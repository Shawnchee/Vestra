# Create .env.local from this file. Never commit real credentials.
# Get a Gemini API key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=
# Optional separate Gemini project key; retried on quota/provider errors.
GEMINI_FALLBACK_API_KEY=

# Set this to the public app URL on hosts other than Vercel for share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must be a model available to your current Gemini API free-tier project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Separate-model fallback used only after a temporary 5xx or timeout.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# On-demand two-voice Council audio brief. Uses the same server-side Gemini key.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Optional: override the default Gemini 3.5 Flash-Lite model for individual roles.
GEMINI_BULL_MODEL=
GEMINI_BEAR_MODEL=
GEMINI_NEUTRAL_MODEL=
GEMINI_COUNCIL_MODEL=

# Optional: tune how many recent news results the server asks for (max 20).
NEWS_MAX_RECORDS=12
